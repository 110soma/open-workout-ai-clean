{
  "name": "open-workout-ai",
  "private": true,
  "version": "0.1.1",
  "description": "Local-first workout prescription execution and logging platform",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:large": "vitest run tests/large-data.test.ts --reporter=verbose",
    "test:e2e": "playwright test",
    "audit:public": "node scripts/oss-audit.mjs",
    "audit:history": "node scripts/git-history-audit.mjs",
    "verify": "npm test && npm run build && npm run test:e2e && npm run audit:public && npm run audit:history"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@vitejs/plugin-react": "latest",
    "dexie": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "fake-indexeddb": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
